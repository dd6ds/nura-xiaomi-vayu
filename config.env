# Default build settings for the Nura (formerly postmarketOS) image
# for the Xiaomi POCO X3 Pro (vayu).
#
# Every value can be overridden via environment variable or via the
# command line options of build.sh (see ./build.sh --help).

# Nura channel: "edge" (rolling, recommended for testing devices like vayu)
# or a release such as "v26.06".
CHANNEL="${CHANNEL:-edge}"

# Display panel of YOUR phone: "tianma" or "huaxing".
# Check under Android / Ubuntu Touch with:
#   cat /proc/cmdline | grep -o 'dsi_j20s[^ ]*'
#   dsi_j20s_36_02_0a_video_display -> tianma
#   dsi_j20s_42_02_0b_video_display -> huaxing
PANEL="${PANEL:-tianma}"

# User interface: phosh, plasma-mobile, gnome-mobile, sxmo-de-sway, console, ...
UI="${UI:-phosh}"

# Install the UI's optional extra packages (true/false)
UI_EXTRAS="${UI_EXTRAS:-false}"

# Login user + initial password (numeric PIN works best with phosh lockscreen).
# CHANGE THE PASSWORD after the first boot with `passwd`!
NURA_USER="${NURA_USER:-user}"
NURA_PASSWORD="${NURA_PASSWORD:-147147}"

HOSTNAME_NURA="${HOSTNAME_NURA:-nura-vayu}"
TIMEZONE="${TIMEZONE:-Europe/Berlin}"
LOCALE="${LOCALE:-de_DE.UTF-8}"

# Space separated list of additional Alpine/Nura packages, e.g. "htop vim tmux"
EXTRA_PACKAGES="${EXTRA_PACKAGES:-}"

# Root filesystem: ext4, f2fs, btrfs, xfs
FILESYSTEM="${FILESYSTEM:-ext4}"

# pmbootstrap git ref (tag/branch). "latest" = newest release tag.
PMB_REF="${PMB_REF:-latest}"
# gitlab.postmarketos.org redirects to gitlab.nura.eco; pmbootstrap still
# recognises pmaports by the old URL, so keep it.
PMB_REPO="${PMB_REPO:-https://gitlab.postmarketos.org/postmarketOS/pmbootstrap.git}"
PMAPORTS_REPO="${PMAPORTS_REPO:-https://gitlab.postmarketos.org/postmarketOS/pmaports.git}"

# Where builds happen and where the finished image ends up
BUILD_DIR="${BUILD_DIR:-$PWD/build}"
OUT_DIR="${OUT_DIR:-$PWD/out}"

# Compression of the release tarball: zstd, xz or none
COMPRESS="${COMPRESS:-zstd}"
